---
import { SITE } from "@consts";
import type { ResolvedSection } from "@types";

type Props = {
  section: ResolvedSection;
  size?: "sm" | "md";
};

const { section, size = "sm" } = Astro.props;
const visibleSubs = section.subsections.slice(
  0,
  SITE.NUM_POSTS_PER_SECTION_ON_HOMEPAGE,
);
const hasMore = section.subsections.length > visibleSubs.length;

const triggerClass =
  size === "md"
    ? "flex items-center gap-2 rounded-md border border-black/15 px-3 py-2 text-base hover:bg-black/5 focus-visible:bg-black/5 dark:border-white/20 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
    : "flex items-center gap-1 rounded-sm px-1 py-0.5 hover:text-black focus-visible:text-black dark:hover:text-white dark:focus-visible:text-white";

const menuClass =
  size === "md"
    ? "absolute left-0 top-full z-50 mt-1 min-w-48 rounded-md border border-black/15 bg-neutral-100 p-1 text-sm shadow-md dark:border-white/20 dark:bg-neutral-900"
    : "absolute right-0 top-full z-50 mt-1 min-w-36 rounded-md border border-black/15 bg-neutral-100 p-1 text-sm shadow-md dark:border-white/20 dark:bg-neutral-900";
---

<div class="relative inline-block" data-dropdown>
  <button
    type="button"
    aria-expanded="false"
    aria-haspopup="menu"
    aria-controls={`menu-${section.slug}`}
    data-dropdown-trigger
    class={triggerClass}
  >
    <span>{section.name}</span>
    <svg
      width="10"
      height="10"
      viewBox="0 0 10 10"
      aria-hidden="true"
      class="transition-transform duration-200 data-[open=true]:rotate-180"
      data-dropdown-chevron
    >
      <path
        d="M2 4l3 3 3-3"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
  <ul
    id={`menu-${section.slug}`}
    role="menu"
    data-dropdown-menu
    hidden
    class={menuClass}
  >
    {section.description && (
      <li
        role="none"
        class="border-b border-black/10 px-2 pb-1 pt-0.5 text-xs italic opacity-80 dark:border-white/10"
      >
        {section.description}
      </li>
    )}
    {
      visibleSubs.map((sub) => (
        <li role="none">
          <a
            role="menuitem"
            href={sub.url}
            class="block rounded-sm px-2 py-1 hover:bg-black/5 focus-visible:bg-black/5 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
          >
            <div>{sub.name}</div>
            {sub.description && (
              <div class="text-xs opacity-70">{sub.description}</div>
            )}
          </a>
        </li>
      ))
    }
    <li
      role="none"
      class="mt-1 border-t border-black/10 pt-1 dark:border-white/10"
    >
      <a
        role="menuitem"
        href={section.url}
        class="block rounded-sm px-2 py-1 text-xs italic opacity-80 hover:bg-black/5 focus-visible:bg-black/5 dark:hover:bg-white/5 dark:focus-visible:bg-white/5"
      >
        {hasMore ? `all ${section.name.toLowerCase()}` : `see ${section.name.toLowerCase()} page`}
      </a>
    </li>
  </ul>
</div>
