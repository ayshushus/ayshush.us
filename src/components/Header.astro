---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
import { getResolvedNav } from "@lib/nav";

const nav = await getResolvedNav();

const linkClass =
  "rounded-sm px-1 py-0.5 hover:text-black focus-visible:text-black dark:hover:text-white dark:focus-visible:text-white";
const controlClass =
  "flex items-center rounded-md border border-black/15 bg-neutral-100 px-2.5 py-1 text-xs transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:bg-neutral-900 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white";
---

<header transition:persist>
  <Container>
    <div class="flex items-center justify-between gap-3">
      <!-- Wordmark — brand + the way home, always visible -->
      <Link href="/" underline={false}>
        <div class="font-semibold tracking-tight">{SITE.TITLE}</div>
      </Link>

      <div class="flex items-center gap-3">
        <!-- Inline nav — shown when there's room -->
        <nav class="hidden items-center gap-x-5 text-sm sm:flex">
          {nav.map((section) => (
            <a href={section.url} class={linkClass}>
              {section.name}
            </a>
          ))}
        </nav>

        <button id="magnifying-glass" aria-label="Search" class={controlClass}>
          <svg
            height="14"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="14"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
          &nbsp;Search
        </button>

        <!-- Accordion toggle — only when the inline nav is collapsed -->
        <button
          id="nav-toggle"
          type="button"
          aria-label="Toggle menu"
          aria-controls="primary-nav"
          aria-expanded="false"
          class={`${controlClass} sm:hidden`}
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Accordion panel — small screens only, toggled open -->
    <nav id="primary-nav" class="hidden flex-col gap-1 pt-3 text-sm sm:hidden">
      {nav.map((section) => (
        <a href={section.url} class={linkClass}>
          {section.name}
        </a>
      ))}
    </nav>
  </Container>
</header>

<script>
  function setMobileNav(open: boolean) {
    const panel = document.getElementById("primary-nav");
    const toggle = document.getElementById("nav-toggle");
    if (!panel || !toggle) return;
    panel.classList.toggle("hidden", !open);
    panel.classList.toggle("flex", open);
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  }

  // Delegated so it survives view transitions (the header is transition:persist).
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest?.("#nav-toggle")) {
      const panel = document.getElementById("primary-nav");
      setMobileNav(panel?.classList.contains("hidden") ?? true);
    } else if (target.closest?.("#primary-nav a")) {
      setMobileNav(false);
    }
  });

  // Always start closed after a navigation.
  document.addEventListener("astro:page-load", () => setMobileNav(false));
</script>
