---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import NavDropdown from "@components/NavDropdown.astro";
import { SITE } from "@consts";
import { getResolvedNav } from "@lib/nav";

const nav = await getResolvedNav();
---

<header transition:persist>
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-y-3">
      <Link href="/" underline={false}>
        <div class="font-semibold tracking-tight">
          {SITE.TITLE}
        </div>
      </Link>
      <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {nav.map((section) => <NavDropdown section={section} size="sm" />)}
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="flex items-center rounded-md border border-black/15 bg-neutral-100 px-2.5 py-1 text-xs transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:bg-neutral-900 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
        >
          <svg
            height="14"
            stroke-linejoin="round"
            viewBox="0 0 16 16"
            width="14"
            style="color: currentcolor;"
            ><path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
              fill="currentColor"></path></svg
          >
          &nbsp;Search
        </button>
      </nav>
    </div>
  </Container>
</header>

<script>
  function setupDropdowns() {
    const dropdowns = Array.from(
      document.querySelectorAll<HTMLElement>("[data-dropdown]"),
    );

    const closeAll = (except: HTMLElement | null) => {
      for (const d of dropdowns) {
        if (d === except) continue;
        const trigger = d.querySelector<HTMLButtonElement>(
          "[data-dropdown-trigger]",
        );
        const menu = d.querySelector<HTMLElement>("[data-dropdown-menu]");
        const chevron = d.querySelector<HTMLElement>("[data-dropdown-chevron]");
        trigger?.setAttribute("aria-expanded", "false");
        menu?.setAttribute("hidden", "");
        chevron?.setAttribute("data-open", "false");
      }
    };

    for (const d of dropdowns) {
      const trigger = d.querySelector<HTMLButtonElement>(
        "[data-dropdown-trigger]",
      );
      const menu = d.querySelector<HTMLElement>("[data-dropdown-menu]");
      const chevron = d.querySelector<HTMLElement>("[data-dropdown-chevron]");
      if (!trigger || !menu) continue;
      if (trigger.dataset.dropdownWired === "1") continue;
      trigger.dataset.dropdownWired = "1";

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        closeAll(d);
        if (isOpen) {
          trigger.setAttribute("aria-expanded", "false");
          menu.setAttribute("hidden", "");
          chevron?.setAttribute("data-open", "false");
        } else {
          trigger.setAttribute("aria-expanded", "true");
          menu.removeAttribute("hidden");
          chevron?.setAttribute("data-open", "true");
        }
      });

      menu.addEventListener("click", (e) => e.stopPropagation());
    }

    document.addEventListener("click", () => closeAll(null));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAll(null);
    });
  }

  document.addEventListener("DOMContentLoaded", setupDropdowns);
  document.addEventListener("astro:after-swap", setupDropdowns);
</script>
