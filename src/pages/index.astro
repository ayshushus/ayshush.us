---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { getResolvedNav } from "@lib/nav";

const nav = await getResolvedNav();
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">Ayush Ranjan</h1>
      <div class="space-y-16">
        <section class="animate">
          <article class="space-y-4">
            <p>
              Welcome. This is my corner of the internet — a small index of
              what I've worked on, what I've made, and what I'm currently
              digging into.
            </p>
          </article>
        </section>

        <section class="animate space-y-6">
          <h2 class="font-semibold text-black dark:text-white">Explore</h2>
          <ul class="not-prose flex flex-col gap-4">
            {nav.map((section) => (
              <li>
                <ArrowCard
                  href={section.url}
                  title={section.name}
                  description={section.description}
                />
              </li>
            ))}
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">About</h2>
          <article class="space-y-4">
            <p>
              I'm Ayush Ranjan, a software engineer. My path has zig-zagged
              across firmware, data pipelines, clinical analytics, audit
              automation, and teaching — picking up something new at each
              stop and carrying it forward.
            </p>
            <p>
              Lately I spend my time at Mozilla, where I work on
              observability and the systems that keep our products honest.
              Outside of work I tinker on small side projects, take notes on
              papers and frameworks that catch my attention, and try to
              write down what I learn so future-me doesn't have to relearn
              it.
            </p>
            <p>
              I care about clarity over cleverness, durable interfaces over
              flashy ones, and shipping things that hold up after the demo
              is over. If any of that resonates with you, I'd love to hear
              from you.
            </p>
          </article>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            Let's Connect
          </h2>
          <article>
            <p>
              If you want to get in touch about something, or just to say
              hi, reach out on social media or send me an email.
            </p>
          </article>
          <ul class="not-prose flex flex-wrap gap-2">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                  {"/"}
                </li>
              ))
            }
            <li class="line-clamp-1">
              <Link
                href={`mailto:${SITE.EMAIL}`}
                aria-label={`Email ${SITE.TITLE}`}
              >
                {SITE.EMAIL}
              </Link>
            </li>
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
