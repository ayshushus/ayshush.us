---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { HOME } from "@consts";
import { getResolvedNav } from "@lib/nav";

const nav = await getResolvedNav();
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <h1 class="font-semibold text-black dark:text-white">Welcome!</h1>
      <div class="space-y-16">
        <section class="animate">
          <article class="space-y-4">
            <p>
              My name is Ayush Ranjan. I also go by the handle <Link href="https://ayshush.us" external aria-label="Ayush Ranjan's website">@ayshushus</Link>. I like to seek knowledge and benefit from the ability to make connections in various contexts through knowledge. I enjoy exploring how technology can be used to improve people's lives.
            </p>
            <p>
              This is my personal site. I use it to document what I build and what I am reading about. I kept it open source because it helps other people the way it helps me when I come back and reread my own work.
            </p>
          </article>
        </section>

        <section class="animate space-y-6">
          <h2 class="font-semibold text-black dark:text-white">Explore</h2>
          <ul class="not-prose flex flex-col gap-4">
            {nav.map((section) => (
              <li>
                <ArrowCard
                  href={section.url}
                  title={section.name}
                  description={section.description}
                />
              </li>
            ))}
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            Let's Connect
          </h2>
          <article>
            <p>Please feel free to reach out:</p>
          </article>
          <ul class="not-prose flex flex-col gap-2">
            <li class="flex gap-x-2">
              <span>GitHub -</span>
              <Link href="https://github.com/ayshushus" external aria-label="Ayush Ranjan on GitHub">
                @ayshushus
              </Link>
            </li>
            <li class="flex gap-x-2">
              <span>LinkedIn -</span>
              <Link href="https://linkedin.com/in/ayshushus" external aria-label="Ayush Ranjan on LinkedIn">
                @ayshushus
              </Link>
            </li>
            <li class="flex gap-x-2">
              <span>YouTube -</span>
              <Link href="https://youtube.com/@ayshushus" external aria-label="Ayush Ranjan on YouTube">
                @ayshushus
              </Link>
            </li>
            <li class="flex gap-x-2">
              <span>Website -</span>
              <Link href="https://ayshush.us" external aria-label="Ayush Ranjan's website">
                https://ayshush.us
              </Link>
            </li>
            <li class="flex gap-x-2">
              <span>Email -</span>
              <Link href="mailto:ayshushus@gmail.com" aria-label="Email Ayush Ranjan">
                ayshushus@gmail.com
              </Link>
            </li>
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
