---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { getResolvedNav } from "@lib/nav";

export async function getStaticPaths() {
  const nav = await getResolvedNav();
  return nav.map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;

const entries = await getCollection(
  section.slug as any,
  ({ data }: any) => !data.draft,
);
const counts: Record<string, number> = Object.fromEntries(
  section.subsections.map((sub) => [
    sub.dirName,
    (entries as any[]).filter((e) => e.id.split("/")[0] === sub.dirName).length,
  ]),
);
---

<Layout
  title={section.name}
  description={section.description ?? `${section.name} sections.`}
>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="space-y-2">
          <h1 class="animate font-semibold text-black dark:text-white">
            {section.name}
          </h1>
          {section.description && (
            <p class="animate text-sm">{section.description}</p>
          )}
        </div>
        <ul class="animate not-prose flex flex-col gap-2">
          {section.subsections.map((sub) => (
            <li>
              <Link href={sub.url}>
                {sub.name}
                <span class="ml-1 text-sm opacity-60">
                  ({counts[sub.dirName]})
                </span>
              </Link>
              {sub.description && (
                <p class="text-sm opacity-70">{sub.description}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </Container>
</Layout>
