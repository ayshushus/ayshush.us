---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ContentList from "@components/ContentList.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { getResolvedNav } from "@lib/nav";
import { groupPosts, hasStaticPage, type NamedList } from "@lib/lists";

export async function getStaticPaths() {
  // A slug "owned" by a real static page (e.g. src/pages/mozilla/) must not also
  // be generated here, or the two would emit the same /<slug>/index.html. Such a
  // subsection still appears in its parent section's listing — its card just
  // links to the static page instead of a generated one.
  const nav = await getResolvedNav();
  const seen = new Set<string>();
  const paths: any[] = [];

  for (const section of nav) {
    if (!seen.has(section.slug) && !hasStaticPage(section.slug)) {
      seen.add(section.slug);
      paths.push({
        params: { slug: section.slug },
        props: { kind: "section", section, sub: null },
      });
    }
    for (const sub of section.subsections) {
      if (seen.has(sub.urlSlug) || hasStaticPage(sub.urlSlug)) continue;
      seen.add(sub.urlSlug);
      paths.push({
        params: { slug: sub.urlSlug },
        props: { kind: "subsection", section, sub },
      });
    }
  }
  return paths;
}

const { kind, section, sub } = Astro.props;
const slug = Astro.params.slug;

// Subsection posts, grouped by the list FOLDER they live in. No folders => a
// single flat list (with a search box once it's large enough); one or more list
// folders => each renders collapsed with its own "See all" → /<subsection>/<list>.
let groups: NamedList[] = [];
let multiList = false;
if (kind === "subsection" && sub) {
  const all = await getCollection(
    section.slug as any,
    ({ data }: any) => !data.draft,
  );
  const filtered = (all as any[]).filter(
    (e) => e.id.split("/")[0] === sub.dirName,
  );
  groups = groupPosts(section, sub, filtered, sub.rules.sortBy ?? "date");
  multiList = groups.some((g) => g.key !== "");
}

// Section page lists its subsections as a single list.
const subsectionItems =
  kind === "section"
    ? section.subsections.map((s: any) => ({
        href: s.url,
        title: s.name,
        description: s.description,
      }))
    : [];

const conflict = kind === "section" ? section.conflict : sub?.conflict;
const pageTitle = kind === "section" ? section.name : sub!.name;
const pageDescription =
  kind === "section"
    ? section.description ?? `${section.name} sections.`
    : sub!.description ?? `${sub!.name} posts.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        {kind === "subsection" && (
          <div class="animate">
            <BackToPrevious href={section.url}>
              Back to {section.name}
            </BackToPrevious>
          </div>
        )}

        {kind === "section" && (
          <div class="animate">
            <BackToPrevious href="/">Back to Home</BackToPrevious>
          </div>
        )}

        {conflict && (
          <div class="animate space-y-2 rounded-lg border border-red-500/50 bg-red-500/10 p-4 text-sm">
            <div class="font-semibold text-red-700 dark:text-red-300">
              Slug conflict on <code>/{slug}</code>
            </div>
            <p>
              Multiple entries claim this URL. Rename one of them by editing
              its <code>_config.md</code>:
            </p>
            <ul class="list-disc pl-5">
              {conflict.map((c: any) => (
                <li>
                  <span>{c.label}</span>
                  {" — "}
                  <code class="text-xs">{c.source}</code>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="space-y-2">
          <h1 class="animate font-semibold text-black dark:text-white">
            {pageTitle}
          </h1>
          {kind === "section" && section.description && (
            <p class="animate text-sm opacity-80">{section.description}</p>
          )}
          {kind === "subsection" && sub!.description && (
            <p class="animate text-sm opacity-80">{sub!.description}</p>
          )}
        </div>

        {kind === "section" && (
          <ContentList items={subsectionItems} searchable />
        )}

        {kind === "subsection" && groups.length === 0 && (
          <p class="animate text-sm opacity-70">No posts yet.</p>
        )}

        {kind === "subsection" && !multiList && groups.length === 1 && (
          <ContentList items={groups[0].items} searchable />
        )}

        {kind === "subsection" && multiList && (
          <div class="space-y-10">
            {groups.map((g) =>
              g.key === "" ? (
                <ContentList items={g.items} searchable />
              ) : (
                <ContentList
                  heading={g.heading}
                  items={g.items}
                  seeAllHref={`${sub!.url}/${g.key}`}
                />
              ),
            )}
          </div>
        )}
      </div>
    </aside>
  </Container>
</Layout>
