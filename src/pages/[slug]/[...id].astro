---
import { getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Giscus from "@components/Giscus.astro";
import { entryHref, getResolvedNav, isNumericName, sortPosts } from "@lib/nav";

export async function getStaticPaths() {
  const nav = await getResolvedNav();
  const paths: any[] = [];
  for (const section of nav) {
    const entries = await getCollection(
      section.slug as any,
      ({ data }: any) => !data.draft,
    );
    for (const sub of section.subsections) {
      if (sub.conflict) continue;
      for (const entry of entries as any[]) {
        const segments = String(entry.id).split("/");
        if (segments[0] !== sub.dirName) continue;
        const localId = segments.slice(1).join("/");
        if (!localId) continue;
        if (sub.rules.pdfOnNumericName && isNumericName(localId)) continue;
        paths.push({
          params: { slug: sub.urlSlug, id: localId },
          props: { section, subsection: sub, post: entry },
        });
      }
    }
  }
  return paths;
}

const { section, subsection, post } = Astro.props;
const { Content, headings } = await render(post);

const all = await getCollection(
  section.slug as any,
  ({ data }: any) => !data.draft,
);
const peers = sortPosts(
  (all as any[]).filter((e) => e.id.split("/")[0] === subsection.dirName),
  subsection.rules.sortBy ?? "date",
);

const nav = await getResolvedNav();
const idx = peers.findIndex((p: any) => p.id === post.id);
const toNavPost = (p: any) =>
  p ? { href: entryHref(p, nav), title: p.data.title } : undefined;
const prevPost = toNavPost(idx > 0 ? peers[idx - 1] : undefined);
const nextPost = toNavPost(
  idx >= 0 && idx < peers.length - 1 ? peers[idx + 1] : undefined,
);
---

<Layout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <BackToPrevious href={subsection.url}>
        Back to {subsection.name}
      </BackToPrevious>
    </div>
    <div class="my-10 space-y-1">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        {post.body && (
          <div class="font-base text-sm">{readingTime(post.body)}</div>
        )}
      </div>
      <h1 class="animate text-3xl font-semibold text-black dark:text-white">
        {post.data.title}
      </h1>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="animate flex gap-2 pt-1">
          {post.data.tags.map((tag: string) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-sm border border-black/15 px-2 py-1 text-sm transition-colors duration-300 ease-in-out hover:bg-black/5 hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/20 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </div>
    {headings.length > 0 && <TableOfContents headings={headings} />}
    <article class="animate">
      <Content />
      <div class="mt-24">
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />
      </div>
      <div class="mt-24">
        <Giscus />
      </div>
    </article>
  </Container>
</Layout>
