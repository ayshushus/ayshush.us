---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import BackToPrevious from "@components/BackToPrevious.astro";

const TITLE = "Autocomplete";
const DESCRIPTION =
  "Research notes toward an autocomplete model — input representations, architectures, and decoding.";

// Auto-discover every research note in this folder. Drop a new .md file in and
// it shows up here. `order` (frontmatter) sorts ascending; ties fall back to title.
const modules = import.meta.glob("./*.md", { eager: true });
const notes = Object.values(modules)
  .map((m: any) => ({
    url: m.url as string,
    title: (m.frontmatter?.title as string) ?? m.url,
    description: m.frontmatter?.description as string | undefined,
    order: (m.frontmatter?.order as number) ?? 0,
  }))
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));
---

<Layout title={TITLE} description={DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="animate">
          <BackToPrevious href="/pontoon">Back to Pontoon</BackToPrevious>
        </div>

        <div class="space-y-2">
          <h1 class="animate font-semibold text-black dark:text-white">
            {TITLE}
          </h1>
          <p class="animate text-sm opacity-80">{DESCRIPTION}</p>
        </div>

        {notes.length === 0 ? (
          <p class="animate text-sm opacity-70">No notes yet.</p>
        ) : (
          <ul class="animate not-prose flex flex-col gap-4">
            {notes.map((note) => (
              <li>
                <ArrowCard
                  href={note.url}
                  title={note.title}
                  description={note.description}
                />
              </li>
            ))}
          </ul>
        )}
      </div>
    </aside>
  </Container>
</Layout>
