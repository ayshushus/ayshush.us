---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ContentList from "@components/ContentList.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { getMozillaLists } from "@lib/mozilla-lists";

const lists = await getMozillaLists();
const isEmpty = lists.every((l) => l.items.length === 0);
---

<Layout title="Mozilla" description="Articles, issue notes, and projects.">
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="animate">
          <BackToPrevious href="/">Back to Home</BackToPrevious>
        </div>

        <div class="space-y-2">
          <h1 class="animate font-semibold text-black dark:text-white">
            Mozilla
          </h1>
        </div>

        {lists.map((list) => (
          <ContentList
            heading={list.heading}
            items={list.items}
            seeAllHref={`/mozilla/${list.key}`}
          />
        ))}

        {isEmpty && (
          <p class="animate text-sm opacity-70">Nothing here yet.</p>
        )}
      </div>
    </aside>
  </Container>
</Layout>
